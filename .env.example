# Postgres connection used by the API, worker and Prisma migrations.
# Inside docker-compose the host is the service name (`postgres`);
# running locally against a port-mapped container, use `localhost`.
DATABASE_URL=postgresql://payroll:payroll@postgres:5432/payroll

# Only needed for `prisma migrate dev` / `db:migrate:generate`, which use a
# throwaway shadow database to detect drift. Not required in production.
SHADOW_DATABASE_URL=postgresql://payroll:payroll@postgres:5432/payroll_shadow

REDIS_URL=redis://redis:6379

# Jobs the worker processes in parallel, across DIFFERENT employees. Events for
# the SAME employee are always serialised by the per-employee ordering lock,
# regardless of this value.
WORKER_CONCURRENCY=10

# Simulated payroll provider. Set both rates to 0 for a deterministic demo, or
# SIMULATED_TEMPORARY_FAILURE_RATE=1 to exercise the retry path end to end.
SIMULATED_TEMPORARY_FAILURE_RATE=0.2
SIMULATED_PERMANENT_FAILURE_RATE=0.05
SIMULATED_MIN_LATENCY_MS=500
SIMULATED_MAX_LATENCY_MS=3000

PORT=3000
NODE_ENV=development
